{
  "name": "Fullstack FastAPI + React DevContainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/university-health-container",
  "remoteUser": "vscode",
"features": {
  "ghcr.io/devcontainers/features/node:1": {
    "version": "20",
    "pnpmVersion": "latest"
  }
},

"postCreateCommand": "bash .devcontainer/setup.sh",
"customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/university-health-container/backend/.venv/bin/python",
        "python.analysis.extraPaths": [
          "/workspaces/university-health-container/backend",
          "/workspaces/university-health-container/backend/.venv/Lib/site-packages",
          "/workspaces/university-health-container/backend/.venv/lib/python3.12/site-packages"
        ],
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.diagnosticMode": "workspace",
        "python.analysis.indexing": true,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.organizeImports": "explicit"
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "tailwindCSS.includeLanguages": {
          "typescript": "javascript",
          "typescriptreact": "html"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ckolkman.vscode-postgres",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "forwardPorts": [8000, 5173, 5432, 6379],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite React Frontend",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL 16",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "silent"
    }
  }
}